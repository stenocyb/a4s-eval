   "source": [
    "sample_size = min(50, len(df))\n",
    "df_sample = df.sample(n=sample_size, random_state=42)\n",
    "\n",
    "fig3, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "fig3.suptitle(\"Monotonicity Score Analysis\", fontsize=16, fontweight=\"bold\")\n",
    "\n",
    "mean_score = df[\"score\"].mean()\n",
    "median_score = df[\"score\"].median()\n",
    "\n",
    "axes[0].hist(df[\"score\"], bins=20, edgecolor=\"black\", alpha=0.7, color=\"skyblue\")\n",
    "axes[0].axvline(\n",
    "    mean_score,\n",
    "    color=\"red\",\n",
    "    linestyle=\"--\",\n",
    "    linewidth=2, \n",
    "    label=f\"Mean: {mean_score:.4f}\"\n",
    ")\n",
    "axes[0].axvline(\n",
    "    median_score,\n",
    "    color=\"green\",\n",
    "    linestyle=\"--\",\n",
    "    linewidth=2, \n",
    "    label=f\"Median: {median_score:.4f}\"\n",
    ")\n",
    "axes[0].set_xlabel(\"Monotonicity Score\", fontsize=11)\n",
    "axes[0].set_ylabel(\"Frequency\", fontsize=11)\n",
    "axes[0].set_title(\"Score Distribution\", fontsize=12, fontweight=\"bold\")\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3, axis=\"y\")\n",
    "\n",
    "axes[1].scatter(\n",
    "    df_sample[\"time\"],\n",
    "    df_sample[\"score\"],\n",
    "    alpha=0.5,\n",
    "    s=10, \n",
    "    color=\"darkblue\",\n",
    "    edgecolors='none',\n",
    "    rasterized=True\n",
    ")\n",
    "axes[1].axhline(mean_score, color=\"red\", linestyle=\"--\", linewidth=1.5, alpha=0.7)\n",
    "axes[1].axhline(median_score, color=\"green\", linestyle=\"--\", linewidth=1.5, alpha=0.7)\n",
    "axes[1].set_xlabel(\"Time\", fontsize=11)\n",
    "axes[1].set_ylabel(\"Monotonicity Score\", fontsize=11)\n",
    "axes[1].set_title(f\"Score vs Time (n={sample_size:,})\", fontsize=12, fontweight=\"bold\")\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "axes[1].tick_params(axis='x', labelsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
